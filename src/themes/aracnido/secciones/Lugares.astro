---
import type { DatosEvento } from '../../../lib/eventos';

interface Props {
  lugares: DatosEvento['lugares'];
}

const { lugares } = Astro.props;
---

<section class="escena">
  <div class="contenedor">
    <h2 class="titulo-seccion" data-anim="sube">Dónde y cuándo</h2>

    <div class="lugares" data-anim-grupo>
      {
        lugares.map((lugar) => (
          <article class="lugar">
            <p class="lugar__titulo">{lugar.titulo}</p>
            <p class="lugar__hora">{lugar.hora}</p>
            <p class="lugar__nombre">{lugar.nombre}</p>
            <p class="lugar__direccion">{lugar.direccion}</p>

            {lugar.mapa && (
              <a
                class="lugar__mapa"
                href={lugar.mapa}
                target="_blank"
                rel="noopener noreferrer"
              >
                Ver en el mapa
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lugares {
    display: grid;
    gap: 1rem;
  }

  /* El grupo entra en cascada: GSAP necesita el estado inicial en los hijos. */
  :global(.js) .lugares > * {
    opacity: 0;
    transform: translateY(2rem);
  }

  .lugar {
    padding: 1.4rem;
    border: 1px solid rgba(243, 240, 234, 0.12);
    border-radius: 1.1rem;
    background: linear-gradient(
      165deg,
      rgba(46, 77, 167, 0.28) 0%,
      rgba(10, 10, 20, 0.5) 100%
    );
    text-align: center;
  }

  .lugar__titulo {
    margin-block-end: 0.5rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-rojo);
  }

  .lugar__hora {
    margin-block-end: 0.6rem;
    font-family: var(--f-titulo);
    font-size: 2rem;
    line-height: 1;
    color: var(--c-oro);
  }

  .lugar__nombre {
    margin-block-end: 0.2rem;
    font-weight: 700;
    color: var(--c-texto);
  }

  .lugar__direccion {
    margin-block-end: 1.1rem;
    font-size: 0.92rem;
    color: var(--c-texto-suave);
  }

  .lugar__mapa {
    display: inline-block;
    padding: 0.7rem 1.6rem;
    border: 1px solid var(--c-rojo);
    border-radius: 999px;
    color: var(--c-texto);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    min-height: 2.75rem;
    line-height: 1.4rem;
  }
</style>
