---
import Telarana from '../Telarana.astro';

interface Props {
  despedida?: string;
  anfitriones?: { titulo: string; nombres: string[] };
}

const { despedida, anfitriones } = Astro.props;
---

<section class="escena cierre">
  <span class="cierre__web">
    <Telarana esquina="abajo-der" tamano="13rem" />
  </span>

  <div class="contenedor cierre__centro">
    {
      anfitriones && (
        <div data-anim="sube">
          <p class="cierre__etiqueta">{anfitriones.titulo}</p>
          <p class="cierre__anfitriones">{anfitriones.nombres.join(' · ')}</p>
        </div>
      )
    }

    {
      despedida && (
        <p class="cierre__despedida" data-anim="escala" data-anim-retraso="0.2">
          {despedida}
        </p>
      )
    }

    <p class="cierre__firma">Invitación creada con ClickPass</p>
  </div>
</section>

<style>
  .cierre {
    position: relative;
    overflow: hidden;
    padding-block-end: clamp(5rem, 16vh, 8rem);
  }

  .cierre__web {
    position: absolute;
    inset-block-end: -2rem;
    inset-inline-end: -2rem;
    opacity: 0.5;
    pointer-events: none;
  }

  .cierre__centro {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .cierre__etiqueta {
    margin-block-end: 0.3rem;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-texto-suave);
  }

  .cierre__anfitriones {
    margin-block-end: 2.5rem;
    font-family: var(--f-titulo);
    font-size: 1.3rem;
    color: var(--c-texto);
  }

  .cierre__despedida {
    margin-block-end: 3rem;
    font-family: var(--f-titulo);
    font-size: clamp(2rem, 10vw, 3rem);
    line-height: 1.1;
    text-wrap: balance;
    color: var(--c-oro);
  }

  .cierre__firma {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: rgba(243, 240, 234, 0.35);
  }
</style>
