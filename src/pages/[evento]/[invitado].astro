---
import Tema from '../../components/Tema.astro';
import { eventosConLista } from '../../lib/eventos';
import type { Evento, Invitado } from '../../lib/eventos';

export async function getStaticPaths() {
  const eventos = await eventosConLista();

  return eventos.flatMap((evento) => {
    if (evento.data.pases.modo !== 'lista') return [];

    return evento.data.pases.invitados.map((invitado) => ({
      params: { evento: evento.id, invitado: invitado.slug },
      props: { evento, invitado },
    }));
  });
}

interface Props {
  evento: Evento;
  invitado: Invitado;
}

const { evento, invitado } = Astro.props;
---

{/* Link nominal: /mateo-6-anios/familia-lopez */}
<Tema evento={evento} invitado={invitado} />
