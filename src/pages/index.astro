---
import { eventosVivos } from '../lib/eventos';
import { fechaLarga } from '../lib/eventos';
import { ruta } from '../lib/rutas';

/**
 * Panel interno: el indice de todo lo que hay publicado, con los links listos
 * para copiar y mandar. No es una pagina de cara al publico.
 */
const eventos = (await eventosVivos()).sort(
  (a, b) => a.data.fecha.getTime() - b.data.fecha.getTime(),
);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Invitaciones · ClickPass</title>
  </head>
  <body>
    <main>
      <h1>Invitaciones</h1>
      <p class="intro">{eventos.length} evento(s) activos. Los archivados no aparecen.</p>

      {
        eventos.map((evento) => {
          const d = evento.data;
          const nominales = d.pases.modo === 'lista' ? d.pases.invitados : [];

          return (
            <article class="tarjeta">
              <header>
                <h2>
                  <a href={ruta(evento.id)}>{d.festejado.nombre}</a>
                  <span class:list={['estado', `estado--${d.estado}`]}>{d.estado}</span>
                </h2>
                <p class="meta">
                  {d.tipo} · {fechaLarga(d.fecha, d.zonaHoraria)}
                </p>
              </header>

              <p class="link">
                Link general: <code>/{evento.id}</code>
              </p>

              {nominales.length > 0 && (
                <details>
                  <summary>{nominales.length} links nominales</summary>
                  <ul>
                    {nominales.map((i) => (
                      <li>
                        <a href={ruta(`${evento.id}/${i.slug}`)}>{i.nombre}</a>
                        <span class="pases">{i.pases} pases</span>
                        <code>/{evento.id}/{i.slug}</code>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </article>
          );
        })
      }
    </main>

    <style>
      body {
        margin: 0;
        padding: 2rem 1.25rem 4rem;
        background: #12121a;
        color: #ececf1;
        font-family: system-ui, sans-serif;
        line-height: 1.5;
      }

      main {
        max-width: 44rem;
        margin-inline: auto;
      }

      h1 {
        margin: 0 0 0.25rem;
        font-size: 1.6rem;
      }

      .intro {
        margin: 0 0 2rem;
        color: #9a9aab;
        font-size: 0.9rem;
      }

      .tarjeta {
        margin-block-end: 1rem;
        padding: 1.1rem 1.2rem;
        border: 1px solid #2a2a38;
        border-radius: 0.8rem;
        background: #191922;
      }

      h2 {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem;
        margin: 0 0 0.2rem;
        font-size: 1.15rem;
      }

      a {
        color: #7fb2ff;
      }

      .estado {
        padding: 0.12rem 0.5rem;
        border-radius: 999px;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .estado--publicado {
        background: #14532d;
        color: #86efac;
      }

      .estado--borrador {
        background: #4a3c08;
        color: #fbd24e;
      }

      .meta,
      .link {
        margin: 0 0 0.5rem;
        color: #9a9aab;
        font-size: 0.85rem;
      }

      code {
        padding: 0.1rem 0.35rem;
        border-radius: 0.3rem;
        background: #2a2a38;
        font-size: 0.8rem;
      }

      summary {
        cursor: pointer;
        font-size: 0.88rem;
        color: #c7c7d1;
      }

      ul {
        margin: 0.6rem 0 0;
        padding-inline-start: 1.1rem;
      }

      li {
        margin-block-end: 0.35rem;
        font-size: 0.85rem;
      }

      .pases {
        margin-inline: 0.5rem;
        color: #9a9aab;
      }
    </style>
  </body>
</html>
