---
import Publico from '../../layouts/Publico.astro';
import Icono from '../../components/Icono.astro';
import { TIPOS_EVENTO, type TipoEvento } from '../../lib/config';
import { plantillasPublicas } from '../../plantillas';

const tipo = Astro.url.searchParams.get('tipo') as TipoEvento | null;
const todas = plantillasPublicas();
const lista = tipo && tipo in TIPOS_EVENTO ? todas.filter((m) => m.tiposEvento.includes(tipo)) : todas;

// Solo se ofrecen filtros que tengan al menos una plantilla.
const tiposConPlantilla = (Object.keys(TIPOS_EVENTO) as TipoEvento[]).filter((t) =>
  todas.some((m) => m.tiposEvento.includes(t)),
);

// El catalogo cambia solo con un deploy: se puede cachear en el borde.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
---

<Publico
  titulo="ClickPass"
  descripcion="Invitaciones digitales animadas para bodas, XV años y cumpleaños. Cada invitado recibe su link y confirma en un toque."
>
  <section class="hero pub-ancho">
    <p class="hero__antetitulo">Invitaciones digitales</p>
    <h1 class="hero__titulo">Una invitación que se abre como un regalo</h1>
    <p class="hero__texto">
      Elige un diseño, cuéntanos los detalles y envía a cada invitado su propio link por WhatsApp. Ellos confirman en un
      toque; tú ves quién viene desde tu teléfono.
    </p>
    <div class="acciones">
      <a class="btn btn--primario" href="#disenos">Ver diseños</a>
      <a class="btn" href="#como-funciona">Cómo funciona</a>
    </div>
  </section>

  <section class="pub-ancho" id="disenos">
    <div class="cabecera" style="margin-bottom:1.25rem">
      <h2 class="seccion-titulo">Diseños</h2>
      <nav class="pildoras" aria-label="Filtrar por tipo de evento">
        <a class="pildora" href="/catalogo#disenos" aria-current={!tipo ? 'true' : undefined}>Todos</a>
        {
          tiposConPlantilla.map((t) => (
            <a class="pildora" href={`/catalogo?tipo=${t}#disenos`} aria-current={tipo === t ? 'true' : undefined}>
              {TIPOS_EVENTO[t]}
            </a>
          ))
        }
      </nav>
    </div>

    {
      lista.length === 0 ? (
        <div class="vacio tarjeta">
          <h3>Pronto habrá diseños para este tipo de evento</h3>
          <p>Mientras tanto, podemos hacerte uno a medida.</p>
        </div>
      ) : (
        <div class="rejilla-catalogo">
          {lista.map((m) => (
            <a class="diseno" href={`/catalogo/${m.slug}`}>
              <div class="diseno__imagen">
                <img src={m.portada} alt="" loading="lazy" width="1200" height="630" />
              </div>
              <div class="diseno__texto">
                <p class="suave pequeno">{m.tiposEvento.map((t) => TIPOS_EVENTO[t]).join(' · ')}</p>
                <h3>{m.nombre}</h3>
                <p class="suave">{m.descripcion}</p>
                <span class="diseno__ver">
                  Ver demo <Icono nombre="atras" class="flecha" />
                </span>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </section>

  <section class="pub-ancho como" id="como-funciona">
    <h2 class="seccion-titulo">Cómo funciona</h2>
    <ol class="pasos-pub">
      <li>
        <span class="pasos-pub__num">1</span>
        <h3>Elige tu diseño</h3>
        <p class="suave">Mira las demos y escríbenos por WhatsApp. Si no encuentras el tuyo, lo diseñamos a medida.</p>
      </li>
      <li>
        <span class="pasos-pub__num">2</span>
        <h3>Llena tus datos</h3>
        <p class="suave">Te damos un panel privado: textos, lugares y tu lista de invitados desde un Excel. O mándanos todo y lo hacemos por ti.</p>
      </li>
      <li>
        <span class="pasos-pub__num">3</span>
        <h3>Envía y relájate</h3>
        <p class="suave">Cada invitado recibe su link con su nombre y sus pases. Tú ves en tiempo real quién confirmó.</p>
      </li>
    </ol>
  </section>
</Publico>

<style>
  .hero {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-block: clamp(3rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero__antetitulo {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--acento);
  }

  .hero__titulo {
    max-width: 16ch;
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .hero__texto {
    max-width: 38rem;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--texto-suave);
  }

  .seccion-titulo {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 500;
  }

  .rejilla-catalogo {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
  }

  .diseno {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--borde);
    border-radius: var(--r-lg);
    background: var(--superficie);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .diseno:hover {
    border-color: var(--borde-fuerte);
    transform: translateY(-2px);
  }

  .diseno__imagen {
    overflow: hidden;
    aspect-ratio: 1200 / 630;
    background: var(--superficie-2);
  }

  .diseno__imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .diseno:hover .diseno__imagen img {
    transform: scale(1.03);
  }

  .diseno__texto {
    display: grid;
    gap: 0.45rem;
    padding: 1.25rem 1.35rem 1.4rem;
  }

  .diseno__texto h3 {
    font-size: 1.5rem;
    font-weight: 500;
  }

  .diseno__ver {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    color: var(--acento);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .diseno__ver :global(.flecha) {
    width: 1rem;
    height: 1rem;
    transform: rotate(180deg);
  }

  .como {
    margin-top: clamp(4rem, 9vw, 6rem);
  }

  .pasos-pub {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 2rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pasos-pub li {
    display: grid;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--borde-fuerte);
  }

  .pasos-pub__num {
    font-family: var(--f-titulo);
    font-size: 2.2rem;
    line-height: 1;
    font-variant-numeric: lining-nums;
    color: var(--acento);
  }

  .pasos-pub h3 {
    font-size: 1.3rem;
    font-weight: 500;
  }
</style>
