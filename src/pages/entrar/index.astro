---
import Simple from '../../layouts/Simple.astro';
import { solicitarCodigo } from '../../lib/acciones/acceso';
import { texto } from '../../lib/formularios';

if (Astro.locals.usuario?.rol === 'cliente') return Astro.redirect('/panel');

let error = '';
let email = '';
if (Astro.request.method === 'POST') {
  email = texto(await Astro.request.formData(), 'email', 200).toLowerCase();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    error = 'Escribe un correo válido.';
  } else {
    const r = await solicitarCodigo(email);
    if (r.ok) return Astro.redirect(`/entrar/codigo?email=${encodeURIComponent(email)}`);
    error = r.error ?? '';
  }
}
---

<Simple titulo="Entrar a mi panel">
  <h1>Tu panel</h1>
  <p class="suave">Escribe el correo con el que te registramos y te enviaremos un código.</p>
  {error && <p class="alerta alerta--peligro">{error}</p>}
  <form method="post" class="formulario">
    <label class="campo">
      <span>Correo</span>
      <input type="email" name="email" value={email} required autocomplete="email" autofocus />
    </label>
    <button type="submit" class="btn btn--primario btn--bloque">Enviarme un código</button>
  </form>
  <p class="pequeno suave">¿Tienes el link de tu panel que te enviamos por WhatsApp? También sirve para entrar.</p>
</Simple>
