---
import Tema from '../components/Tema.astro';
import { eventosVivos } from '../lib/eventos';
import type { Evento } from '../lib/eventos';

export async function getStaticPaths() {
  const eventos = await eventosVivos();

  return eventos.map((evento) => ({
    params: { evento: evento.id },
    props: { evento },
  }));
}

interface Props {
  evento: Evento;
}

const { evento } = Astro.props;
---

{/* Link generico: sirve para difusion abierta y como vista previa del cliente. */}
<Tema evento={evento} />
