---
/**
 * Jurasico: cumpleanos de dinosaurios. Huevo que se rompe -> dino + volcan +
 * nombre -> fecha -> exploradores -> cuenta regresiva -> expedicion (lugares)
 * -> dress code -> regalos -> pase -> confirmacion -> cierre. Huellas que
 * aparecen al bajar y hojas que se mecen.
 */
import Invitacion from '../../layouts/Invitacion.astro';
import Confirmacion from '../compartidas/Confirmacion.astro';
import Base from '../kit/Base.astro';
import Foto from '../kit/Foto.astro';
import Fecha from '../kit/Fecha.astro';
import Familia from '../kit/Familia.astro';
import Cuenta from '../kit/Cuenta.astro';
import Lugares from '../kit/Lugares.astro';
import Dress from '../kit/Dress.astro';
import Regalos from '../kit/Regalos.astro';
import Pase from '../kit/Pase.astro';
import Cierre from '../kit/Cierre.astro';
import Portada from './Portada.astro';
import Dino from './Dino.astro';
import { extraTexto } from '../kit/extras';
import { manifiesto } from './manifiesto';
import type { PropsPlantilla } from '../tipos';

type Props = PropsPlantilla;
const { evento, invitado, confirmacion } = Astro.props;
const d = evento.contenido;
const x = d.extras as Record<string, unknown>;
const hueco = evento.estado === 'borrador' || confirmacion.modo === 'demo';
const preset = manifiesto.presets?.find((p) => p.id === evento.preset);
const linkQr = invitado ? `${Astro.url.origin}/${evento.slug}/${invitado.token}` : undefined;
---

<Invitacion
  titulo={`${d.festejado.nombre} · ${d.tipo}`}
  descripcion={invitado ? `${invitado.nombre}, ¡únete a la expedición jurásica!` : (d.frase ?? d.tipo)}
  imagen={d.galeria[0] ?? manifiesto.portada}
  tema="jurasico"
  colorTema={manifiesto.colorTema}
  variables={preset?.variables}
  borrador={evento.estado === 'borrador'}
  musica={d.musica?.archivo}
>
  <Base />
  <Portada nombre={d.festejado.nombre} edad={d.festejado.edad} invitado={invitado?.nombre} />

  <main data-kit>
    <section class="escena">
      <div class="contenedor k-centro ju-heroe">
        <div class="ju-escena" aria-hidden="true">
          <span class="ju-volcan"><span class="ju-humo"></span></span>
          <span class="ju-dino" data-anim="sube"><Dino /></span>
          <span class="ju-hoja ju-hoja--1" data-ju-hoja></span>
          <span class="ju-hoja ju-hoja--2" data-ju-hoja></span>
        </div>
        <p class="ju-rawr" data-anim="escala">¡RAWR!</p>
        <p class="k-caps" data-anim="sube">{d.tipo}</p>
        <h1 class="ju-nombre" data-k-split>{d.festejado.nombre}</h1>
        {d.festejado.edad && <p class="ju-edad" data-anim="escala">{d.festejado.edad}<small>años</small></p>}
        {d.frase && <p class="k-texto-suave" data-anim="sube">{d.frase}</p>}
        <div class="ju-foto" data-anim="sube"><Foto src={d.galeria[0]} forma="circulo" hueco={hueco} texto="Foto del explorador" /></div>
      </div>
    </section>

    <div class="ju-huellas" aria-hidden="true">
      {Array.from({ length: 6 }, (_, i) => <span class="ju-huella" data-ju-huella style={`--i:${i}`}></span>)}
    </div>

    <Fecha evento={evento} antes="Fecha de la" titulo="expedición" />
    <Familia anfitriones={d.anfitriones} />
    <Cuenta evento={evento} antes="Faltan" titulo="para la aventura" hoy="¡Hoy es la aventura!" />
    <Lugares lugares={d.lugares} zona={evento.zonaHoraria} antes="Punto de encuentro" titulo="¡Al campamento!" textoMapa="Ver mapa" />
    {d.dressCode && <Dress titulo={d.dressCode.titulo} nota={d.dressCode.nota} antes="Equipo de explorador" />}
    <Regalos extras={x} antes="Un tesoro para" titulo="el explorador" />
    <Pase invitado={invitado} linkQr={linkQr} antes="Credencial de explorador" forma="boleto" />
    <section class="escena">
      <div class="contenedor k-confirmacion" data-anim="sube">
        <Confirmacion confirmacion={confirmacion} invitado={invitado} zonaHoraria={evento.zonaHoraria} titulo="¿Te unes a la expedición?" />
      </div>
    </section>
    <Cierre foto={d.galeria[1]} hueco={false} despedida={d.despedida} hashtag={extraTexto(x, 'hashtag')}>
      <div style="width:8rem"><Dino /></div>
    </Cierre>
  </main>
</Invitacion>

<script>
  import { montarKit, gsap, movimientoReducido } from '../kit/animaciones';
  document.addEventListener('invitacion:abierta', () => {
    montarKit({ entradaFoto: 'circulo' });
    if (movimientoReducido()) return;
    // Huellas: aparecen una tras otra, como si el dino caminara.
    const huellas = document.querySelectorAll('[data-ju-huella]');
    if (huellas.length) {
      gsap.from(huellas, {
        opacity: 0,
        scale: 0.3,
        duration: 0.35,
        stagger: 0.25,
        ease: 'back.out(3)',
        scrollTrigger: { trigger: huellas[0], start: 'top 85%', once: true },
      });
    }
    // Hojas que se mecen con el viento.
    document.querySelectorAll('[data-ju-hoja]').forEach((h, i) => {
      gsap.to(h, { rotate: `+=${8 + i * 4}`, duration: 2.2 + i * 0.4, repeat: -1, yoyo: true, ease: 'sine.inOut' });
    });
  });
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Chewy&display=swap');

  html[data-tema='jurasico'] {
    --ju-arena: #f4ead5;
    --ju-verde: #2f6b3a;
    --ju-lima: #a3c75a;
    --ju-naranja: #f28c28;
    --ju-tinta: #243024;
    --ju-f-titulo: 'Fredoka', system-ui, sans-serif;
    --ju-f-deco: 'Chewy', system-ui, sans-serif;
    --ju-f-cuerpo: 'Fredoka', system-ui, sans-serif;
    --c-fondo: var(--ju-arena);
    --c-texto: var(--ju-tinta);
    --f-cuerpo: var(--ju-f-cuerpo);
    --f-titulo: var(--ju-f-titulo);
  }

  html[data-tema='jurasico'] body {
    background:
      radial-gradient(circle at 10% 20%, color-mix(in srgb, var(--ju-lima) 22%, transparent) 0 6rem, transparent 6.1rem),
      radial-gradient(circle at 90% 70%, color-mix(in srgb, var(--ju-naranja) 14%, transparent) 0 8rem, transparent 8.1rem),
      var(--ju-arena);
    background-attachment: fixed;
  }

  html[data-tema='jurasico'] [data-kit] {
    --k-superficie: #fffaf0;
    --k-texto: var(--ju-tinta);
    --k-suave: color-mix(in srgb, var(--ju-tinta) 65%, var(--ju-arena));
    --k-acento: var(--ju-verde);
    --k-acento-texto: #fff;
    --k-linea: color-mix(in srgb, var(--ju-verde) 35%, transparent);
    --k-f-titulo: var(--ju-f-titulo);
    --k-f-cuerpo: var(--ju-f-cuerpo);
    --k-f-deco: var(--ju-f-deco);
    --k-caps-espaciado: 0.2em;
    --k-radio: 1.4rem;
    --k-sombra: 0 10px 0 -2px color-mix(in srgb, var(--ju-verde) 25%, transparent);
    --k-cuenta-fondo: var(--ju-lima);
    --k-cuenta-num: var(--ju-tinta);
    --k-cuenta-radio: 50% 50% 46% 46% / 60% 60% 40% 40%;
    --k-foto-filete: 3px dashed #fff;
  }

  html[data-tema='jurasico'] [data-kit] .k-deco { color: var(--ju-naranja); text-shadow: 2px 2px 0 var(--ju-verde); }
  html[data-tema='jurasico'] [data-kit] .k-caps { font-weight: 600; color: var(--ju-verde); }

  .ju-heroe { gap: 0.3rem; }
  .ju-escena { position: relative; width: min(20rem, 88vw); height: 11rem; margin-bottom: 0.4rem; }
  .ju-volcan {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 9rem;
    height: 7rem;
    background: linear-gradient(180deg, var(--ju-naranja) 0 18%, #6b4a33 18%);
    clip-path: polygon(38% 0, 62% 0, 100% 100%, 0 100%);
  }
  .ju-humo {
    position: absolute;
    top: -2.6rem;
    left: 38%;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: rgb(120 110 100 / 0.35);
    box-shadow: 1.2rem -1rem 0 0.2rem rgb(120 110 100 / 0.3), -0.6rem -2rem 0 0.4rem rgb(120 110 100 / 0.25);
    animation: humo 4s ease-in-out infinite;
  }
  @keyframes humo { 50% { transform: translateY(-0.6rem) scale(1.1); } }
  .ju-dino { position: absolute; left: 0; bottom: 0; width: 13rem; }
  .ju-hoja {
    position: absolute;
    width: 6rem;
    height: 2.6rem;
    border-radius: 0 100% 0 100%;
    background: var(--ju-verde);
    transform-origin: 0 50%;
  }
  .ju-hoja--1 { top: -0.5rem; left: -2rem; transform: rotate(20deg); }
  .ju-hoja--2 { top: 1rem; right: -2.5rem; background: var(--ju-lima); transform: rotate(-150deg); }
  .ju-rawr {
    margin: 0.6rem 0 0;
    font-family: var(--ju-f-deco);
    font-size: 2.2rem;
    color: var(--ju-naranja);
    transform: rotate(-6deg);
  }
  .ju-nombre {
    margin: 0;
    font-family: var(--ju-f-titulo);
    font-size: clamp(3rem, 16vw, 4.4rem);
    font-weight: 700;
    line-height: 1;
    color: var(--ju-verde);
  }
  .ju-edad {
    display: grid;
    place-items: center;
    width: 5.6rem;
    aspect-ratio: 1;
    margin: 0.4rem 0;
    border-radius: 50%;
    background: var(--ju-naranja);
    font-family: var(--ju-f-deco);
    font-size: 2.8rem;
    line-height: 0.9;
    color: #fff;
    box-shadow: 0 6px 0 color-mix(in srgb, var(--ju-naranja) 60%, #000);
  }
  .ju-edad small { font-size: 0.85rem; font-family: var(--ju-f-cuerpo); }
  .ju-foto { width: min(13rem, 60vw); margin-top: 1rem; }
  .ju-huellas { display: grid; justify-items: center; gap: 0.3rem; padding-block: 1rem; }
  .ju-huella {
    width: 2.2rem;
    height: 2.6rem;
    background: color-mix(in srgb, var(--ju-verde) 55%, transparent);
    clip-path: path('M17 38 C8 38 6 28 10 22 C13 18 21 18 24 22 C28 28 26 38 17 38 Z M7 16 a4 5 0 1 0 0.1 0 Z M17 11 a4 5 0 1 0 0.1 0 Z M27 16 a4 5 0 1 0 0.1 0 Z');
    transform: translateX(calc((var(--i) % 2 * 2 - 1) * 1.4rem)) rotate(calc((var(--i) % 2 * 2 - 1) * 10deg));
  }
</style>
