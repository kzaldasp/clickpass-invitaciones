---
/**
 * Un huevo con manchas en su nido. Al tocarlo tiembla, se parte en zigzag y
 * la mitad de arriba sale volando. Solo @keyframes en los hijos.
 */
interface Props { nombre: string; edad?: number; invitado?: string }
const { nombre, edad, invitado } = Astro.props;
---

<div class="portada" data-gate-portada>
  <span class="hoja hoja--1" aria-hidden="true"></span>
  <span class="hoja hoja--2" aria-hidden="true"></span>
  <span class="hoja hoja--3" aria-hidden="true"></span>

  <p class="portada__para" data-p-entra>{invitado ? `¡${invitado}!` : '¡Algo está por nacer!'}</p>

  <button class="huevo" type="button" data-gate-abrir aria-label="Romper el huevo" data-p-entra>
    <span class="huevo__mitad huevo__mitad--arriba"></span>
    <span class="huevo__mitad huevo__mitad--abajo"></span>
    <span class="huevo__nido"></span>
  </button>

  <p class="portada__nombre" data-p-entra>{nombre}{edad ? ` · ${edad}` : ''}</p>
  <p class="portada__accion" data-p-entra>Toca el huevo para romperlo</p>
</div>

<script>
  import { entradaPortada } from '../kit/animaciones';
  entradaPortada(document.querySelector('[data-gate-portada]'));
</script>

<style>
  .portada {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.8rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 60%, #fff8e6 0%, transparent 55%),
      var(--ju-arena);
    opacity: 1;
  }

  .portada[data-saliendo='true'] {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease 1.5s;
  }

  .hoja {
    position: absolute;
    width: 12rem;
    height: 5rem;
    border-radius: 0 100% 0 100%;
    background: var(--ju-verde);
    opacity: 0.9;
  }

  .hoja--1 { top: -1rem; left: -3rem; transform: rotate(25deg); }
  .hoja--2 { top: 3rem; right: -4rem; transform: rotate(-35deg); background: var(--ju-lima); }
  .hoja--3 { bottom: -1.5rem; left: 20%; transform: rotate(-10deg); }

  .portada__para,
  .portada__nombre {
    margin: 0;
    font-family: var(--ju-f-titulo);
    text-align: center;
    color: var(--ju-verde);
  }

  .portada__para { font-size: 1.4rem; }
  .portada__nombre { font-size: clamp(2.2rem, 12vw, 3rem); font-weight: 700; }

  .portada__accion {
    margin: 0;
    font-family: var(--ju-f-cuerpo);
    font-weight: 600;
    color: color-mix(in srgb, var(--ju-verde) 70%, #000);
  }

  .huevo {
    position: relative;
    width: 9rem;
    height: 11.5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .huevo__mitad {
    position: absolute;
    inset: 0 0 1.2rem;
    border-radius: 50% 50% 46% 46% / 60% 60% 40% 40%;
    background:
      radial-gradient(circle at 30% 30%, var(--ju-lima) 0 0.9rem, transparent 0.95rem),
      radial-gradient(circle at 68% 48%, var(--ju-lima) 0 0.7rem, transparent 0.75rem),
      radial-gradient(circle at 40% 72%, var(--ju-lima) 0 0.6rem, transparent 0.65rem),
      radial-gradient(circle at 35% 25%, #fff 0%, transparent 40%),
      #f7f0dc;
    box-shadow: inset -10px -8px 0 rgb(0 0 0 / 0.06);
  }

  .huevo__mitad--arriba { clip-path: polygon(0 0, 100% 0, 100% 48%, 84% 56%, 68% 46%, 50% 58%, 34% 46%, 18% 56%, 0 46%); }
  .huevo__mitad--abajo { clip-path: polygon(0 46%, 18% 56%, 34% 46%, 50% 58%, 68% 46%, 84% 56%, 100% 48%, 100% 100%, 0 100%); }

  .huevo__nido {
    position: absolute;
    inset: auto -1rem 0;
    height: 2.6rem;
    border-radius: 50%;
    background: repeating-linear-gradient(115deg, #b98a4a 0 4px, #8f6534 4px 8px);
  }

  .huevo { animation: tiembla 2.8s ease-in-out infinite; }

  @keyframes tiembla {
    0%, 80%, 100% { transform: rotate(0); }
    84% { transform: rotate(-5deg); }
    88% { transform: rotate(5deg); }
    92% { transform: rotate(-3deg); }
  }

  .portada[data-saliendo='true'] .huevo { animation: sacude 0.5s ease-in-out; }
  .portada[data-saliendo='true'] .huevo__mitad--arriba { animation: sale-arriba 1s cubic-bezier(0.5, 0, 0.8, 0.4) 0.5s forwards; }
  .portada[data-saliendo='true'] .portada__accion { animation: fuera 0.3s forwards; }

  @keyframes sacude {
    20% { transform: rotate(-9deg); }
    40% { transform: rotate(9deg); }
    60% { transform: rotate(-6deg); }
    80% { transform: rotate(6deg); }
  }

  @keyframes sale-arriba { to { transform: translate(40%, -140%) rotate(40deg); opacity: 0; } }
  @keyframes fuera { to { opacity: 0; } }
</style>
