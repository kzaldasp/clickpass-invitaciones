---
import QrEntrada from '../../compartidas/QrEntrada.astro';

/**
 * El pase es la parte que el invitado captura y guarda. Se ve como un boleto
 * troquelado y, cuando el link es nominal, lleva su nombre impreso.
 */
interface Props {
  /** Nombre del invitado, si abrio su link personal. */
  invitado?: string;
  /** "4 pases" ya formateado, o null si el evento no declara cantidad. */
  pases: string | null;
  nota?: string;
  tipo: string;
  /** Link personal: el QR de entrada lo lleva. Solo en links personales. */
  linkQr?: string;
}

const { invitado, pases, nota, tipo, linkQr } = Astro.props;
---

<section class="escena">
  <div class="contenedor">
    <h2 class="titulo-seccion" data-anim="sube">Tu acceso</h2>

    <div class="pase" data-anim="escala" data-anim-retraso="0.15">
      <div class="pase__cuerpo">
        <p class="pase__evento">{tipo}</p>

        {invitado ? (
          <p class="pase__nombre">{invitado}</p>
        ) : (
          <p class="pase__nombre pase__nombre--generico">Invitación general</p>
        )}

        {nota && <p class="pase__nota">{nota}</p>}
      </div>

      <div class="pase__talon">
        {
          pases ? (
            <>
              <span class="pase__cantidad">{pases.split(' ')[0]}</span>
              <span class="pase__unidad">{pases.split(' ')[1]}</span>
            </>
          ) : (
            <span class="pase__unidad">Bienvenido</span>
          )
        }
      </div>
    </div>

    {
      linkQr && (
        <div class="pase__qr" data-anim="sube" data-anim-retraso="0.25">
          <QrEntrada link={linkQr} />
        </div>
      )
    }

    <p class="pase__aviso" data-anim="sube" data-anim-retraso="0.3">
      {linkQr ? 'Presenta este código en la entrada' : 'Presenta esta pantalla en la entrada'}
    </p>
  </div>
</section>

<style>
  .pase {
    display: grid;
    /* El talon es fijo y el cuerpo toma el resto: aguanta nombres largos. */
    grid-template-columns: 1fr 7.5rem;
    border-radius: 1.2rem;
    overflow: hidden;
    background: var(--c-texto);
    color: var(--c-fondo);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.45);
  }

  .pase__cuerpo {
    padding: 1.5rem 1.2rem;
  }

  .pase__evento {
    margin-block-end: 0.5rem;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-rojo-osc);
  }

  .pase__nombre {
    margin: 0;
    font-family: var(--f-titulo);
    font-size: clamp(1.5rem, 7vw, 2rem);
    line-height: 1.1;
    color: var(--c-fondo);
    text-wrap: balance;
  }

  .pase__nombre--generico {
    color: rgba(10, 10, 20, 0.55);
  }

  .pase__nota {
    margin-block: 0.7rem 0;
    font-size: 0.85rem;
    color: rgba(10, 10, 20, 0.7);
  }

  .pase__talon {
    display: grid;
    place-content: center;
    gap: 0.1rem;
    padding: 1rem 0.5rem;
    background: linear-gradient(160deg, var(--c-rojo) 0%, var(--c-rojo-osc) 100%);
    color: #fff;
    text-align: center;
    /* Troquel: los puntos son el corte del boleto. */
    border-inline-start: 3px dashed rgba(255, 255, 255, 0.55);
  }

  .pase__cantidad {
    font-family: var(--f-titulo);
    font-size: 3rem;
    line-height: 1;
  }

  .pase__unidad {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .pase__qr {
    --qr-tamano: 9.5rem;
    display: grid;
    justify-items: center;
    margin-block-start: 1.25rem;
  }

  .pase__aviso {
    margin-block-start: 1rem;
    margin-block-end: 0;
    font-size: 0.82rem;
    text-align: center;
    color: var(--c-texto-suave);
  }
</style>
