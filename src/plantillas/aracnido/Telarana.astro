---
/**
 * Telarana de esquina. Un cuadrante de 200x200 con radios y anillos combados
 * hacia el centro, como los hilos reales. Se dibuja sola con DrawSVGPlugin.
 *
 * La geometria esta calculada, no dibujada a mano: los anillos son curvas
 * cuadraticas cuyo punto de control cae al 90% del radio, que es lo que le da
 * la caida del hilo.
 */
interface Props {
  /** Esquina donde se ancla. Rota el cuadrante segun corresponda. */
  esquina?: 'arriba-izq' | 'arriba-der' | 'abajo-izq' | 'abajo-der';
  tamano?: string;
  class?: string;
}

const { esquina = 'arriba-izq', tamano = '11rem', class: clase } = Astro.props;

const rotacion = {
  'arriba-izq': 'rotate(0deg)',
  'arriba-der': 'rotate(90deg)',
  'abajo-der': 'rotate(180deg)',
  'abajo-izq': 'rotate(270deg)',
}[esquina];
---

<svg
  class:list={['telarana', clase]}
  data-telarana
  viewBox="0 0 200 200"
  fill="none"
  aria-hidden="true"
  style={`--tamano:${tamano}; --rotacion:${rotacion};`}
>
  <path class="hilo hilo--radio" d="M0 0 L200.0 0.0" />
  <path class="hilo hilo--radio" d="M0 0 L193.2 51.8" />
  <path class="hilo hilo--radio" d="M0 0 L173.2 100.0" />
  <path class="hilo hilo--radio" d="M0 0 L141.4 141.4" />
  <path class="hilo hilo--radio" d="M0 0 L100.0 173.2" />
  <path class="hilo hilo--radio" d="M0 0 L51.8 193.2" />
  <path class="hilo hilo--radio" d="M0 0 L0.0 200.0" />

  <path class="hilo hilo--anillo" d="M46.0 0.0 Q41.0 5.4 44.4 11.9 Q38.2 15.8 39.8 23.0 Q32.8 25.2 32.5 32.5 Q25.2 32.8 23.0 39.8 Q15.8 38.2 11.9 44.4 Q5.4 41.0 0.0 46.0" />
  <path class="hilo hilo--anillo" d="M86.0 0.0 Q76.7 10.1 83.1 22.3 Q71.5 29.6 74.5 43.0 Q61.4 47.1 60.8 60.8 Q47.1 61.4 43.0 74.5 Q29.6 71.5 22.3 83.1 Q10.1 76.7 0.0 86.0" />
  <path class="hilo hilo--anillo" d="M126.0 0.0 Q112.4 14.8 121.7 32.6 Q104.8 43.4 109.1 63.0 Q90.0 69.0 89.1 89.1 Q69.0 90.0 63.0 109.1 Q43.4 104.8 32.6 121.7 Q14.8 112.4 0.0 126.0" />
  <path class="hilo hilo--anillo" d="M166.0 0.0 Q148.1 19.5 160.3 43.0 Q138.0 57.2 143.8 83.0 Q118.5 90.9 117.4 117.4 Q90.9 118.5 83.0 143.8 Q57.2 138.0 43.0 160.3 Q19.5 148.1 0.0 166.0" />
  <path class="hilo hilo--anillo" d="M200.0 0.0 Q178.5 23.5 193.2 51.8 Q166.3 68.9 173.2 100.0 Q142.8 109.6 141.4 141.4 Q109.6 142.8 100.0 173.2 Q68.9 166.3 51.8 193.2 Q23.5 178.5 0.0 200.0" />
</svg>

<style>
  .telarana {
    width: var(--tamano);
    height: var(--tamano);
    transform: var(--rotacion);
    transform-origin: center;
    pointer-events: none;
  }

  .hilo {
    stroke: var(--c-hilo, rgba(243, 240, 234, 0.38));
    stroke-linecap: round;
    fill: none;
  }

  .hilo--radio {
    stroke-width: 2;
  }

  .hilo--anillo {
    stroke-width: 1.5;
    stroke: var(--c-hilo-anillo, rgba(243, 240, 234, 0.26));
  }
</style>
