---
/**
 * Una funda negra con la tarjeta blanca asomando. Al tocar, la funda baja y la
 * tarjeta sube; luego todo se desvanece.
 */
interface Props { nombre: string; fecha: string; invitado?: string }
const { nombre, fecha, invitado } = Astro.props;
const iniciales = nombre.split(/\s*(?:&|\sy\s)\s*/i).map((p) => p.trim().charAt(0).toUpperCase()).slice(0, 2);
---

<div class="portada" data-gate-portada>
  <button class="sobre" type="button" data-gate-abrir aria-label="Abrir invitación" data-p-entra>
    <span class="tarjeta">
      <span class="tarjeta__ini">{iniciales[0]}<i></i>{iniciales[1]}</span>
      <span class="tarjeta__nombre">{nombre}</span>
      <span class="tarjeta__fecha">{fecha}</span>
    </span>
    <span class="funda">
      <span class="funda__para">{invitado ? `Para ${invitado}` : 'Una invitación para ti'}</span>
      <span class="funda__abrir">Toca para abrir</span>
    </span>
  </button>
</div>

<script>
  import { entradaPortada } from '../kit/animaciones';
  entradaPortada(document.querySelector('[data-gate-portada]'));
</script>

<style>
  .portada {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: var(--ma-fondo);
    opacity: 1;
  }

  .portada[data-saliendo='true'] {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease 1.5s;
  }

  .sobre {
    position: relative;
    width: min(18rem, 80vw);
    height: min(26rem, 72vh);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .tarjeta {
    position: absolute;
    inset: 0 0.8rem 18%;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.8rem;
    background: #fff;
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.3);
    transform: translateY(-14%);
  }

  .tarjeta__ini {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--ma-f-titulo);
    font-size: 3rem;
    color: var(--ma-negro);
  }

  .tarjeta__ini i {
    width: 1px;
    height: 3rem;
    background: var(--ma-oro);
  }

  .tarjeta__nombre {
    font-family: var(--ma-f-cuerpo);
    font-size: 0.8rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--ma-negro);
  }

  .tarjeta__fecha {
    font-family: var(--ma-f-cuerpo);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    color: var(--ma-oro);
  }

  .funda {
    position: absolute;
    inset: 42% 0 0;
    display: grid;
    align-content: end;
    justify-items: center;
    gap: 0.4rem;
    padding: 1.4rem;
    background: var(--ma-negro);
    box-shadow: 0 30px 50px -20px rgb(0 0 0 / 0.55);
    color: #fff;
  }

  .funda::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline: 0;
    height: 3.2rem;
    background: var(--ma-negro);
    clip-path: polygon(0 0, 50% 60%, 100% 0, 100% 100%, 0 100%);
    transform: translateY(-2.4rem);
  }

  .funda__para {
    font-family: var(--ma-f-titulo);
    font-size: 1.5rem;
    color: var(--ma-oro-claro);
  }

  .funda__abrir {
    font-family: var(--ma-f-cuerpo);
    font-size: 0.68rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .portada[data-saliendo='true'] .funda { animation: funda-baja 1.2s cubic-bezier(0.6, 0, 0.3, 1) forwards; }
  .portada[data-saliendo='true'] .tarjeta { animation: tarjeta-sube 1.2s cubic-bezier(0.6, 0, 0.3, 1) forwards; }

  @keyframes funda-baja { to { transform: translateY(120%); } }
  @keyframes tarjeta-sube { to { transform: translateY(-4%) scale(1.08); } }
</style>
