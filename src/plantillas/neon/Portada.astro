---
/**
 * Letrero de neon apagado sobre una pared oscura. El interruptor lo enciende:
 * parpadea como un tubo real y la escena se abre con un destello.
 */
interface Props { nombre: string; tipo: string; invitado?: string }
const { nombre, tipo, invitado } = Astro.props;
---

<div class="portada" data-gate-portada>
  <div class="letrero">
    <p class="letrero__tipo">{tipo}</p>
    <p class="letrero__nombre">{nombre}</p>
    {invitado && <p class="letrero__para">con {invitado}</p>}
  </div>
  <button class="interruptor" type="button" data-gate-abrir data-p-entra>
    <span class="interruptor__palanca"></span>
    <span class="interruptor__texto">Encender la fiesta</span>
  </button>
</div>

<script>
  import { entradaPortada } from '../kit/animaciones';
  entradaPortada(document.querySelector('[data-gate-portada]'));
</script>

<style>
  .portada {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 3rem;
    padding: 1.5rem;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.025) 1px, transparent 1px) 0 0 / 38px 22px,
      linear-gradient(0deg, rgb(255 255 255 / 0.025) 1px, transparent 1px) 0 0 / 38px 22px,
      #0a0a12;
    opacity: 1;
  }

  .portada[data-saliendo='true'] {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease 1.5s;
  }

  .letrero {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    text-align: center;
  }

  .letrero p {
    margin: 0;
    color: #3a3346;
    text-shadow: none;
  }

  .letrero__tipo {
    font-family: var(--ne-f-caps);
    font-size: 1.6rem;
    letter-spacing: 0.3em;
  }

  .letrero__nombre {
    font-family: var(--ne-f-neon);
    font-size: clamp(3.4rem, 18vw, 5.4rem);
    line-height: 1.1;
  }

  .letrero__para {
    font-family: var(--ne-f-cuerpo);
    font-size: 1rem;
  }

  .interruptor {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    padding: 0;
    border: 0;
    background: none;
    color: #cfc8dd;
    cursor: pointer;
  }

  .interruptor__palanca {
    position: relative;
    width: 3.4rem;
    height: 5.4rem;
    border-radius: 0.7rem;
    background: #1b1826;
    box-shadow: inset 0 0 0 2px #2d2840;
  }

  .interruptor__palanca::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.6rem;
    width: 1.6rem;
    height: 2.4rem;
    translate: -50% 0;
    border-radius: 0.4rem;
    background: #3a3346;
  }

  .interruptor__texto {
    font-family: var(--ne-f-caps);
    font-size: 1.1rem;
    letter-spacing: 0.2em;
  }

  /* Encendido: parpadeo de tubo y luego glow estable. */
  .portada[data-saliendo='true'] .letrero__tipo { animation: prende-b 1.2s steps(1) forwards; }
  .portada[data-saliendo='true'] .letrero__nombre { animation: prende-a 1.2s steps(1) 0.15s forwards; }
  .portada[data-saliendo='true'] .letrero__para { animation: prende-b 1.2s steps(1) 0.3s forwards; }
  .portada[data-saliendo='true'] .interruptor__palanca::after { animation: palanca 0.2s forwards; }

  @keyframes palanca { to { bottom: 2.4rem; background: var(--ne-a); box-shadow: 0 0 14px var(--ne-a); } }

  @keyframes prende-a {
    0%, 20%, 40% { color: #3a3346; text-shadow: none; }
    10%, 30%, 55%, 100% { color: #fff; text-shadow: 0 0 6px #fff, 0 0 18px var(--ne-a), 0 0 42px var(--ne-a), 0 0 80px var(--ne-a); }
  }

  @keyframes prende-b {
    0%, 25%, 45% { color: #3a3346; text-shadow: none; }
    15%, 35%, 60%, 100% { color: #fff; text-shadow: 0 0 6px #fff, 0 0 18px var(--ne-b), 0 0 40px var(--ne-b); }
  }
</style>
