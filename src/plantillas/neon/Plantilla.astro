---
/**
 * Neon: cumpleanos de adultos y fiestas de noche. Letrero que se enciende ->
 * nombre en neon que titila + edad en contorno + foto con tubo de luz ->
 * fecha -> palabras -> cuenta regresiva -> lugar -> dress code -> regalos ->
 * pase tipo entrada -> confirmacion -> cierre. Destellos que suben.
 */
import Invitacion from '../../layouts/Invitacion.astro';
import Confirmacion from '../compartidas/Confirmacion.astro';
import Base from '../kit/Base.astro';
import Foto from '../kit/Foto.astro';
import Fecha from '../kit/Fecha.astro';
import Familia from '../kit/Familia.astro';
import Historia from '../kit/Historia.astro';
import Cuenta from '../kit/Cuenta.astro';
import Lugares from '../kit/Lugares.astro';
import Dress from '../kit/Dress.astro';
import Regalos from '../kit/Regalos.astro';
import Pase from '../kit/Pase.astro';
import Cierre from '../kit/Cierre.astro';
import Portada from './Portada.astro';
import { extraTexto } from '../kit/extras';
import { manifiesto } from './manifiesto';
import type { PropsPlantilla } from '../tipos';

type Props = PropsPlantilla;
const { evento, invitado, confirmacion } = Astro.props;
const d = evento.contenido;
const x = d.extras as Record<string, unknown>;
const hueco = evento.estado === 'borrador' || confirmacion.modo === 'demo';
const preset = manifiesto.presets?.find((p) => p.id === evento.preset);
const linkQr = invitado ? `${Astro.url.origin}/${evento.slug}/${invitado.token}` : undefined;
---

<Invitacion
  titulo={`${d.festejado.nombre} · ${d.tipo}`}
  descripcion={invitado ? `${invitado.nombre}, esta noche celebramos juntos.` : (d.frase ?? d.tipo)}
  imagen={d.galeria[0] ?? manifiesto.portada}
  tema="neon"
  colorTema={manifiesto.colorTema}
  variables={preset?.variables}
  borrador={evento.estado === 'borrador'}
  musica={d.musica?.archivo}
>
  <Base />
  <Portada nombre={d.festejado.nombre} tipo={d.tipo} invitado={invitado?.nombre} />

  <div class="k-particulas" aria-hidden="true">
    {Array.from({ length: 14 }, (_, i) => <span class="ne-chispa" data-ne-chispa style={`--c:${i % 2 ? 'var(--ne-a)' : 'var(--ne-b)'}`}></span>)}
  </div>

  <main data-kit>
    <section class="escena">
      <div class="contenedor k-centro ne-heroe">
        <p class="ne-caps ne-brillo-b" data-anim="sube">{d.tipo}</p>
        <h1 class="ne-nombre" data-ne-titila>{d.festejado.nombre}</h1>
        {d.festejado.edad && <p class="ne-edad" data-anim="escala">{d.festejado.edad}</p>}
        {d.frase && <p class="k-texto-suave" data-anim="sube">{d.frase}</p>}
        <div class="ne-marco" data-anim="sube">
          <Foto src={d.galeria[0]} forma="arco" hueco={hueco} />
        </div>
      </div>
    </section>

    <Fecha evento={evento} antes="Save" titulo="the date" />
    <Familia anfitriones={d.anfitriones} />
    <Historia foto={d.galeria[1]} hueco={hueco} antes="Unas palabras" texto={extraTexto(x, 'historia')} forma="cuadro" />
    <Cuenta evento={evento} antes="Faltan" titulo="para la noche" hoy="¡Es hoy!" />
    <Lugares lugares={d.lugares} zona={evento.zonaHoraria} antes="Dónde" titulo="la fiesta" textoMapa="Cómo llegar" />
    {d.dressCode && <Dress titulo={d.dressCode.titulo} nota={d.dressCode.nota} antes="Dress code" />}
    <Regalos extras={x} antes="Si quieres" titulo="un detalle" />
    <Pase invitado={invitado} linkQr={linkQr} antes="Entrada VIP para" forma="boleto" />
    <section class="escena">
      <div class="contenedor k-confirmacion" data-anim="sube">
        <Confirmacion confirmacion={confirmacion} invitado={invitado} zonaHoraria={evento.zonaHoraria} titulo="¿Vienes?" />
      </div>
    </section>
    <Cierre foto={undefined} hueco={false} despedida={d.despedida} hashtag={extraTexto(x, 'hashtag')} />
  </main>
</Invitacion>

<script>
  import { montarKit, lluvia, gsap, movimientoReducido } from '../kit/animaciones';
  document.addEventListener('invitacion:abierta', () => {
    montarKit({ entradaFoto: 'abajo' });
    lluvia('[data-ne-chispa]', { duracion: [8, 13], balanceo: 40, giro: 0, subir: true });
    if (movimientoReducido()) return;
    // El nombre titila de vez en cuando, como un tubo de neon real.
    const n = document.querySelector('[data-ne-titila]');
    if (n) {
      gsap.timeline({ repeat: -1, repeatDelay: 4 })
        .to(n, { opacity: 0.35, duration: 0.05 })
        .to(n, { opacity: 1, duration: 0.05 })
        .to(n, { opacity: 0.5, duration: 0.04, delay: 0.1 })
        .to(n, { opacity: 1, duration: 0.06 });
    }
  });
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Neonderthaw&family=Bebas+Neue&family=Outfit:wght@300;400;600&display=swap');

  html[data-tema='neon'] {
    --ne-a: #ff3ea5;
    --ne-b: #29e7ff;
    --ne-f-neon: 'Neonderthaw', cursive;
    --ne-f-caps: 'Bebas Neue', Impact, sans-serif;
    --ne-f-cuerpo: 'Outfit', system-ui, sans-serif;
    --c-fondo: #0a0a12;
    --c-texto: #efeaf7;
    --f-cuerpo: var(--ne-f-cuerpo);
    --f-titulo: var(--ne-f-caps);
  }

  html[data-tema='neon'] body {
    background:
      radial-gradient(ellipse at 15% 10%, color-mix(in srgb, var(--ne-a) 22%, transparent) 0%, transparent 45%),
      radial-gradient(ellipse at 90% 70%, color-mix(in srgb, var(--ne-b) 16%, transparent) 0%, transparent 45%),
      #0a0a12;
    background-attachment: fixed;
  }

  html[data-tema='neon'] [data-kit] {
    --k-superficie: #13111f;
    --k-texto: #efeaf7;
    --k-suave: #a79fbd;
    --k-acento: var(--ne-a);
    --k-acento-texto: #0a0a12;
    --k-linea: color-mix(in srgb, var(--ne-b) 45%, transparent);
    --k-f-titulo: var(--ne-f-caps);
    --k-f-cuerpo: var(--ne-f-cuerpo);
    --k-f-deco: var(--ne-f-neon);
    --k-caps-espaciado: 0.3em;
    --k-radio: 1rem;
    --k-sombra: 0 0 0 1px color-mix(in srgb, var(--ne-a) 35%, transparent), 0 0 30px -8px var(--ne-a);
    --k-deco-tamano: clamp(3rem, 15vw, 4rem);
    --k-cuenta-num: var(--ne-b);
    --k-foto-filete: 0;
  }

  html[data-tema='neon'] [data-kit] .k-deco {
    color: #fff;
    text-shadow: 0 0 5px #fff, 0 0 16px var(--ne-a), 0 0 34px var(--ne-a);
  }
  html[data-tema='neon'] [data-kit] .kcuenta__num { text-shadow: 0 0 12px var(--ne-b); }
  html[data-tema='neon'] .k-confirmacion .conf__control option { color: #111; }

  .ne-heroe { gap: 0.4rem; }
  .ne-caps { margin: 0; font-family: var(--ne-f-caps); font-size: 2rem; letter-spacing: 0.3em; }
  .ne-brillo-b { color: #fff; text-shadow: 0 0 6px #fff, 0 0 18px var(--ne-b), 0 0 40px var(--ne-b); }
  .ne-nombre {
    margin: 0;
    font-family: var(--ne-f-neon);
    font-size: clamp(4.4rem, 24vw, 7rem);
    font-weight: 400;
    line-height: 1.05;
    color: #fff;
    text-shadow: 0 0 6px #fff, 0 0 20px var(--ne-a), 0 0 46px var(--ne-a), 0 0 90px var(--ne-a);
  }
  .ne-edad {
    margin: 0;
    font-family: var(--ne-f-caps);
    font-size: clamp(7rem, 40vw, 11rem);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 2px var(--ne-b);
    filter: drop-shadow(0 0 10px var(--ne-b));
  }
  .ne-marco {
    width: min(16rem, 72vw);
    margin-top: 1.6rem;
    padding: 0.5rem;
    border: 2px solid var(--ne-a);
    border-radius: 999px 999px 1.4rem 1.4rem;
    box-shadow: 0 0 14px var(--ne-a), inset 0 0 14px var(--ne-a);
    animation: pulso 3s ease-in-out infinite;
  }
  @keyframes pulso { 50% { box-shadow: 0 0 28px var(--ne-a), inset 0 0 20px var(--ne-a); } }
  .ne-chispa {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 10px var(--c), 0 0 20px var(--c);
  }
</style>
