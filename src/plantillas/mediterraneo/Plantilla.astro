---
/**
 * Mediterraneo: boda de playa/civil. Persiana de azulejos -> ventana en arco
 * con contraventanas que se abren + limonero + nombres -> fecha -> padres ->
 * historia -> cuenta regresiva -> lugares -> dress code -> regalos -> pase ->
 * confirmacion -> cierre. Tiras de azulejo como divisores.
 */
import Invitacion from '../../layouts/Invitacion.astro';
import Confirmacion from '../compartidas/Confirmacion.astro';
import Base from '../kit/Base.astro';
import Foto from '../kit/Foto.astro';
import Fecha from '../kit/Fecha.astro';
import Familia from '../kit/Familia.astro';
import Historia from '../kit/Historia.astro';
import Cuenta from '../kit/Cuenta.astro';
import Lugares from '../kit/Lugares.astro';
import Dress from '../kit/Dress.astro';
import Regalos from '../kit/Regalos.astro';
import Pase from '../kit/Pase.astro';
import Cierre from '../kit/Cierre.astro';
import Portada from './Portada.astro';
import Azulejo from './Azulejo.astro';
import Limonero from './Limonero.astro';
import { extraTexto } from '../kit/extras';
import { fechaPartes } from '../../lib/fechas';
import { manifiesto } from './manifiesto';
import type { PropsPlantilla } from '../tipos';

type Props = PropsPlantilla;
const { evento, invitado, confirmacion } = Astro.props;
const d = evento.contenido;
const x = d.extras as Record<string, unknown>;
const hueco = evento.estado === 'borrador' || confirmacion.modo === 'demo';
const preset = manifiesto.presets?.find((p) => p.id === evento.preset);
const linkQr = invitado ? `${Astro.url.origin}/${evento.slug}/${invitado.token}` : undefined;
const f = fechaPartes(evento.fecha, evento.zonaHoraria);
const fechaCorta = `${f.dia} · ${f.mes} · ${f.anio}`;
---

<Invitacion
  titulo={`${d.festejado.nombre} · ${d.tipo}`}
  descripcion={invitado ? `${invitado.nombre}, nos casamos junto al mar y queremos que estés.` : (d.frase ?? d.tipo)}
  imagen={d.galeria[0] ?? manifiesto.portada}
  tema="mediterraneo"
  colorTema={manifiesto.colorTema}
  variables={preset?.variables}
  borrador={evento.estado === 'borrador'}
  musica={d.musica?.archivo}
>
  <Base />
  <Portada nombre={d.festejado.nombre} fecha={fechaCorta} invitado={invitado?.nombre} />
  <Azulejo />

  <main data-kit>
    <section class="escena">
      <div class="contenedor k-centro me-heroe">
        <p class="k-caps" data-anim="sube">{d.tipo}</p>
        <h1 class="me-nombres" data-k-split>{d.festejado.nombre}</h1>
        <p class="k-caps me-fecha" data-anim="sube">{fechaCorta}</p>

        <div class="me-ventana" data-me-ventana data-anim="sube">
          <span class="me-rama me-rama--izq"><Limonero /></span>
          <div class="me-arco"><Foto src={d.galeria[0]} forma="arco" hueco={hueco} /></div>
          <span class="me-contra me-contra--izq" data-me-contra></span>
          <span class="me-contra me-contra--der" data-me-contra></span>
          <span class="me-rama me-rama--der"><Limonero /></span>
        </div>

        {d.frase && <p class="k-texto-suave me-frase" data-anim="sube">{d.frase}</p>}
      </div>
    </section>

    <Azulejo tira id="me-azulejo-t1" />
    <Fecha evento={evento} antes="Reserva la" titulo="fecha" />
    <Familia anfitriones={d.anfitriones} />
    <Historia foto={d.galeria[1]} hueco={hueco} antes="Nuestra historia" texto={extraTexto(x, 'historia')} />
    <Cuenta evento={evento} antes="Faltan" titulo="para el gran día" />
    <Azulejo tira id="me-azulejo-t2" />
    <Lugares lugares={d.lugares} zona={evento.zonaHoraria} antes="Dónde y cuándo" titulo="Te esperamos" textoMapa="Cómo llegar" />
    {d.dressCode && <Dress titulo={d.dressCode.titulo} nota={d.dressCode.nota} />}
    <Regalos extras={x} />
    <Pase invitado={invitado} linkQr={linkQr} antes="Con cariño para" forma="arco" />
    <section class="escena">
      <div class="contenedor k-confirmacion" data-anim="sube">
        <Confirmacion confirmacion={confirmacion} invitado={invitado} zonaHoraria={evento.zonaHoraria} titulo="¿Nos acompañas?" />
      </div>
    </section>
    <Cierre foto={d.galeria[2]} hueco={hueco} despedida={d.despedida} hashtag={extraTexto(x, 'hashtag')} forma="arco">
      <div style="width:10rem"><Limonero /></div>
    </Cierre>
  </main>
</Invitacion>

<script>
  import { montarKit, gsap, movimientoReducido } from '../kit/animaciones';
  document.addEventListener('invitacion:abierta', () => {
    montarKit({ entradaFoto: 'abajo' });
    if (movimientoReducido()) return;
    // Las contraventanas se abren al asomar la ventana.
    const ventana = document.querySelector('[data-me-ventana]');
    if (ventana) {
      gsap.to(ventana.querySelectorAll('[data-me-contra]'), {
        rotateY: (i: number) => (i === 0 ? -105 : 105),
        duration: 1.6,
        ease: 'power3.inOut',
        scrollTrigger: { trigger: ventana, start: 'top 70%', once: true },
      });
    }
    // Ramas de limonero que se mecen con la brisa.
    document.querySelectorAll('[data-me-rama]').forEach((r, i) => {
      gsap.to(r, { rotate: i % 2 ? -4 : 4, duration: 3 + i * 0.4, repeat: -1, yoyo: true, ease: 'sine.inOut' });
    });
  });
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Marcellus&family=Lora:ital,wght@0,400;0,500;1,400&family=Parisienne&display=swap');

  html[data-tema='mediterraneo'] {
    --me-blanco: #fdfcf8;
    --me-azul: #1f4e8c;
    --me-azul-claro: #9dbde3;
    --me-limon: #f4d35e;
    --me-oliva: #7a8b4f;
    --me-tinta: #22324a;
    --me-f-titulo: 'Marcellus', Georgia, serif;
    --me-f-cuerpo: 'Lora', Georgia, serif;
    --me-f-deco: 'Parisienne', cursive;
    --c-fondo: var(--me-blanco);
    --c-texto: var(--me-tinta);
    --f-cuerpo: var(--me-f-cuerpo);
    --f-titulo: var(--me-f-titulo);
  }

  html[data-tema='mediterraneo'] body {
    background:
      radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--me-azul-claro) 25%, transparent) 0%, transparent 55%),
      var(--me-blanco);
  }

  html[data-tema='mediterraneo'] [data-kit] {
    --k-superficie: #fff;
    --k-texto: var(--me-tinta);
    --k-suave: #5d6b80;
    --k-acento: var(--me-azul);
    --k-acento-texto: #fff;
    --k-linea: color-mix(in srgb, var(--me-azul) 30%, transparent);
    --k-f-titulo: var(--me-f-titulo);
    --k-f-cuerpo: var(--me-f-cuerpo);
    --k-f-deco: var(--me-f-deco);
    --k-caps-espaciado: 0.3em;
    --k-radio: 0.8rem;
    --k-sombra: 0 24px 50px -30px rgb(20 50 100 / 0.45);
    --k-deco-tamano: clamp(2.8rem, 14vw, 3.6rem);
    --k-cuenta-fondo: color-mix(in srgb, var(--me-azul-claro) 22%, #fff);
    --k-cuenta-radio: 999px 999px 0.6rem 0.6rem;
  }

  .me-heroe { gap: 0.5rem; }
  .me-nombres { margin: 0; font-family: var(--me-f-deco); font-size: clamp(3rem, 15vw, 4.2rem); font-weight: 400; line-height: 1.1; color: var(--me-azul); }
  .me-fecha { margin: 0 0 1.8rem; }
  .me-ventana { position: relative; width: min(17rem, 72vw); perspective: 900px; }
  .me-arco { position: relative; padding: 0.7rem; border-radius: 999px 999px 0.4rem 0.4rem; background: #fff; box-shadow: 0 0 0 3px var(--me-azul-claro), 0 20px 40px -20px rgb(20 50 100 / 0.5); }
  .me-contra {
    position: absolute;
    top: 0.7rem;
    bottom: 0.7rem;
    width: calc(50% - 0.7rem);
    background: repeating-linear-gradient(180deg, var(--me-azul) 0 12px, color-mix(in srgb, var(--me-azul) 80%, #000) 12px 14px);
    backface-visibility: hidden;
  }
  /* Abiertas por defecto (sin JS o con movimiento reducido la foto se ve);
     con JS arrancan cerradas y se abren al asomar la ventana. */
  .me-contra--izq { left: 0.7rem; border-radius: 999px 0 0 0; transform-origin: left center; transform: rotateY(-105deg); }
  .me-contra--der { right: 0.7rem; border-radius: 0 999px 0 0; transform-origin: right center; transform: rotateY(105deg); }
  @media (prefers-reduced-motion: no-preference) {
    .js .me-contra { transform: rotateY(0deg); }
  }
  .me-rama { position: absolute; z-index: 2; width: 8rem; }
  .me-rama--izq { top: -1.4rem; left: -3rem; transform: scaleX(-1) rotate(-10deg); }
  .me-rama--der { bottom: 1rem; right: -3.2rem; }
  .me-frase { margin-top: 2rem; }
  .azulejo--tira { opacity: 0.9; }
</style>
