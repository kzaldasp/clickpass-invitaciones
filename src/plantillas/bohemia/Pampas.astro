---
/** Tallos de pampa: plumas hechas con trazos finos. Se mecen con [data-bo-pampa]. */
interface Props { tallos?: number }
const { tallos = 5 } = Astro.props;
const lista = Array.from({ length: tallos }, (_, i) => {
  const x = 20 + i * (160 / Math.max(1, tallos - 1));
  const alto = 120 + ((i * 37) % 50);
  const inclina = (i - (tallos - 1) / 2) * 8;
  return { x, alto, inclina };
});
---

<svg class="pampas" viewBox="0 0 200 200" aria-hidden="true">
  {
    lista.map((t) => (
      <g transform={`translate(${t.x} 200) rotate(${t.inclina})`} data-bo-pampa>
        <path d={`M0 0 Q4 -${t.alto / 2} 0 -${t.alto}`} stroke="var(--bo-tallo)" stroke-width="1.4" fill="none" />
        {Array.from({ length: 14 }, (_, j) => {
          const y = -t.alto + j * 5;
          return <path d={`M0 ${y} q${j % 2 ? 10 : -10} -6 ${j % 2 ? 16 : -16} -2`} stroke="var(--bo-pluma)" stroke-width="2.4" stroke-linecap="round" fill="none" opacity=".85" />;
        })}
      </g>
    ))
  }
</svg>

<style>
  .pampas { display: block; width: 100%; overflow: visible; }
  .pampas g { transform-box: fill-box; transform-origin: 50% 100%; }
</style>
