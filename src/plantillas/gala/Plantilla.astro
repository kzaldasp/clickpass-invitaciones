---
/**
 * Gala: boda art deco. Ascensor -> abanico dorado que se dibuja + nombres
 * en oro + fecha en marco escalonado + foto -> fecha -> familias -> historia
 * -> cuenta regresiva -> lugares en linea -> etiqueta -> regalos -> pase ->
 * confirmacion -> cierre.
 */
import Invitacion from '../../layouts/Invitacion.astro';
import Confirmacion from '../compartidas/Confirmacion.astro';
import Base from '../kit/Base.astro';
import Foto from '../kit/Foto.astro';
import Fecha from '../kit/Fecha.astro';
import Familia from '../kit/Familia.astro';
import Historia from '../kit/Historia.astro';
import Cuenta from '../kit/Cuenta.astro';
import Lugares from '../kit/Lugares.astro';
import Dress from '../kit/Dress.astro';
import Regalos from '../kit/Regalos.astro';
import Pase from '../kit/Pase.astro';
import Cierre from '../kit/Cierre.astro';
import Portada from './Portada.astro';
import Abanico from './Abanico.astro';
import { extraTexto } from '../kit/extras';
import { fechaPartes } from '../../lib/fechas';
import { manifiesto } from './manifiesto';
import type { PropsPlantilla } from '../tipos';

type Props = PropsPlantilla;
const { evento, invitado, confirmacion } = Astro.props;
const d = evento.contenido;
const x = d.extras as Record<string, unknown>;
const hueco = evento.estado === 'borrador' || confirmacion.modo === 'demo';
const preset = manifiesto.presets?.find((p) => p.id === evento.preset);
const linkQr = invitado ? `${Astro.url.origin}/${evento.slug}/${invitado.token}` : undefined;
const f = fechaPartes(evento.fecha, evento.zonaHoraria);
const partes = d.festejado.nombre.split(/\s*(?:&|\sy\s)\s*/i).map((p) => p.trim());
---

<Invitacion
  titulo={`${d.festejado.nombre} · ${d.tipo}`}
  descripcion={invitado ? `${invitado.nombre}, le esperamos en nuestra noche de gala.` : (d.frase ?? d.tipo)}
  imagen={d.galeria[0] ?? manifiesto.portada}
  tema="gala"
  colorTema={manifiesto.colorTema}
  variables={preset?.variables}
  borrador={evento.estado === 'borrador'}
  musica={d.musica?.archivo}
>
  <Base />
  <Portada nombre={d.festejado.nombre} invitado={invitado?.nombre} />

  <main data-kit>
    <section class="escena">
      <div class="contenedor k-centro g2-heroe">
        <div class="g2-abanico"><Abanico /></div>
        <p class="k-caps" data-anim="sube">{d.tipo}</p>
        <h1 class="g2-nombres" data-k-split>
          {partes.length === 2 ? <>{partes[0]}<span class="g2-y">&</span>{partes[1]}</> : d.festejado.nombre}
        </h1>
        <div class="g2-fecha" data-anim="escala">
          <span>{f.dia}</span><span class="g2-fecha__mes">{f.mes}</span><span>{f.anio}</span>
        </div>
        <div class="g2-foto" data-anim="sube"><Foto src={d.galeria[0]} forma="arco" hueco={hueco} /></div>
        {d.frase && <p class="k-texto-suave" data-anim="sube">{d.frase}</p>}
      </div>
    </section>

    <Fecha evento={evento} antes="Reserve la" titulo="fecha" />
    <Familia anfitriones={d.anfitriones} />
    <Historia foto={d.galeria[1]} hueco={hueco} antes="Nuestra historia" texto={extraTexto(x, 'historia')} />
    <Cuenta evento={evento} antes="Faltan" titulo="para la gala" hoy="Esta noche es la gala" />
    <Lugares lugares={d.lugares} zona={evento.zonaHoraria} estilo="linea" antes="Programa" titulo="de la noche" textoMapa="Ubicación" />
    {
      d.dressCode && (
        <Dress titulo={d.dressCode.titulo} nota={d.dressCode.nota}>
          <svg viewBox="0 0 80 40" width="80" aria-hidden="true"><path d="M4 6 L36 20 L4 34 Z M76 6 L44 20 L76 34 Z" fill="none" stroke="currentColor" stroke-width="1.4" /><circle cx="40" cy="20" r="5" fill="currentColor" /></svg>
        </Dress>
      )
    }
    <Regalos extras={x} />
    <Pase invitado={invitado} linkQr={linkQr} antes="Admisión para" forma="boleto" />
    <section class="escena">
      <div class="contenedor k-confirmacion" data-anim="sube">
        <Confirmacion confirmacion={confirmacion} invitado={invitado} zonaHoraria={evento.zonaHoraria} titulo="Confirme su asistencia" />
      </div>
    </section>
    <Cierre foto={d.galeria[2]} hueco={hueco} despedida={d.despedida} hashtag={extraTexto(x, 'hashtag')} forma="arco">
      <div style="width:9rem;color:var(--ga2-oro)"><Abanico /></div>
    </Cierre>
  </main>
</Invitacion>

<script>
  import { montarKit } from '../kit/animaciones';
  document.addEventListener('invitacion:abierta', () => montarKit({ entradaFoto: 'centro' }));
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Poiret+One&family=Limelight&family=Josefin+Sans:wght@300;400;600&display=swap');

  html[data-tema='gala'] {
    --ga2-negro: #0e0e0e;
    --ga2-negro-2: #1a1a1a;
    --ga2-oro: #c9a45c;
    --ga2-oro-claro: #f0dfb1;
    --ga2-f-titulo: 'Limelight', 'Didot', serif;
    --ga2-f-deco: 'Poiret One', sans-serif;
    --ga2-f-cuerpo: 'Josefin Sans', system-ui, sans-serif;
    --c-fondo: var(--ga2-negro);
    --c-texto: #efe7d6;
    --f-cuerpo: var(--ga2-f-cuerpo);
    --f-titulo: var(--ga2-f-titulo);
  }

  html[data-tema='gala'] body {
    background:
      repeating-linear-gradient(90deg, transparent 0 60px, color-mix(in srgb, var(--ga2-oro) 5%, transparent) 60px 61px),
      radial-gradient(ellipse at 50% 0%, var(--ga2-negro-2) 0%, var(--ga2-negro) 60%);
    background-attachment: fixed;
  }

  html[data-tema='gala'] [data-kit] {
    --k-superficie: var(--ga2-negro-2);
    --k-texto: #efe7d6;
    --k-suave: #b9ad95;
    --k-acento: var(--ga2-oro);
    --k-acento-texto: #000;
    --k-linea: color-mix(in srgb, var(--ga2-oro) 70%, transparent);
    --k-f-titulo: var(--ga2-f-titulo);
    --k-f-cuerpo: var(--ga2-f-cuerpo);
    --k-f-deco: var(--ga2-f-deco);
    --k-caps-espaciado: 0.4em;
    --k-radio: 0;
    --k-sombra: 0 0 0 4px var(--ga2-negro), 0 0 0 5px color-mix(in srgb, var(--ga2-oro) 50%, transparent);
    --k-deco-tamano: clamp(2.4rem, 12vw, 3.2rem);
    --k-cuenta-num: var(--ga2-oro-claro);
    --k-foto-filete: 1px solid var(--ga2-oro);
    --k-radio-boton: 0;
  }

  html[data-tema='gala'] [data-kit] .k-deco { color: var(--ga2-oro-claro); }
  html[data-tema='gala'] [data-kit] .k-caps { color: var(--ga2-oro); font-weight: 300; }
  html[data-tema='gala'] .k-confirmacion .conf__control option { color: #111; }

  .g2-heroe { gap: 0.8rem; }
  .g2-abanico { width: min(15rem, 70vw); color: var(--ga2-oro); }
  .g2-nombres {
    display: grid;
    margin: 0;
    font-family: var(--ga2-f-titulo);
    font-size: clamp(2.4rem, 12vw, 3.4rem);
    font-weight: 400;
    line-height: 1.1;
    background: linear-gradient(180deg, var(--ga2-oro-claro), var(--ga2-oro) 60%, #8f7236);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .g2-y { font-family: var(--ga2-f-deco); font-size: 0.8em; }
  .g2-fecha {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1.4rem;
    border: 1px solid var(--ga2-oro);
    font-family: var(--ga2-f-deco);
    font-size: 1.4rem;
    letter-spacing: 0.2em;
    color: var(--ga2-oro-claro);
    clip-path: polygon(6% 0, 94% 0, 94% 12%, 100% 12%, 100% 88%, 94% 88%, 94% 100%, 6% 100%, 6% 88%, 0 88%, 0 12%, 6% 12%);
  }
  .g2-fecha__mes { font-size: 0.8em; text-transform: uppercase; }
  .g2-foto { width: min(17rem, 74vw); margin-top: 1.4rem; padding: 0.5rem; border: 1px solid var(--ga2-oro); border-radius: 999px 999px 0 0; }
</style>
