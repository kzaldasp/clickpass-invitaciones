---
/**
 * Puertas de ascensor art deco con indicador de piso. Al tocar, la aguja del
 * indicador gira hasta arriba y las puertas se deslizan hacia los lados.
 */
interface Props { nombre: string; invitado?: string }
const { nombre, invitado } = Astro.props;
---

<div class="portada" data-gate-portada>
  <div class="indicador" aria-hidden="true">
    <span class="indicador__aguja"></span>
  </div>
  <div class="puerta puerta--izq" aria-hidden="true"></div>
  <div class="puerta puerta--der" aria-hidden="true"></div>

  <div class="centro">
    <p class="centro__para" data-p-entra>{invitado ? `Para ${invitado}` : 'Está invitado a'}</p>
    <p class="centro__nombre" data-p-entra>{nombre}</p>
    <button class="centro__boton" type="button" data-gate-abrir data-p-entra>Subir a la gala</button>
  </div>
</div>

<script>
  import { entradaPortada } from '../kit/animaciones';
  entradaPortada(document.querySelector('[data-gate-portada]'));
</script>

<style>
  .portada {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #000;
    opacity: 1;
  }

  .portada[data-saliendo='true'] {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease 1.9s;
  }

  .indicador {
    position: absolute;
    top: 1.2rem;
    left: 50%;
    z-index: 3;
    width: 7rem;
    height: 3.6rem;
    translate: -50% 0;
    border: 2px solid var(--ga2-oro);
    border-bottom: 0;
    border-radius: 7rem 7rem 0 0;
    background:
      repeating-conic-gradient(from 270deg at 50% 100%, var(--ga2-oro) 0deg 1deg, transparent 1deg 22.5deg),
      var(--ga2-negro);
  }

  .indicador__aguja {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 2px;
    height: 2.8rem;
    background: var(--ga2-oro-claro);
    transform-origin: bottom center;
    transform: rotate(-80deg);
  }

  .puerta {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    background:
      repeating-linear-gradient(90deg, transparent 0 18px, color-mix(in srgb, var(--ga2-oro) 35%, transparent) 18px 19px),
      linear-gradient(180deg, var(--ga2-negro-2) 0%, var(--ga2-negro) 100%);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--ga2-oro) 60%, transparent);
  }

  .puerta::after {
    content: '';
    position: absolute;
    inset: 22% 14%;
    border: 1px solid var(--ga2-oro);
    background: repeating-conic-gradient(from 0deg at 50% 50%, color-mix(in srgb, var(--ga2-oro) 30%, transparent) 0deg 4deg, transparent 4deg 15deg);
    clip-path: polygon(20% 0, 80% 0, 80% 6%, 100% 6%, 100% 94%, 80% 94%, 80% 100%, 20% 100%, 20% 94%, 0 94%, 0 6%, 20% 6%);
  }

  .puerta--izq { left: 0; border-right: 1px solid var(--ga2-oro); }
  .puerta--der { right: 0; border-left: 1px solid var(--ga2-oro); }

  .centro {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    width: min(18rem, 86vw);
    padding: 2rem 1.2rem;
    border: 1px solid var(--ga2-oro);
    background: rgb(0 0 0 / 0.72);
    text-align: center;
    clip-path: polygon(8% 0, 92% 0, 92% 4%, 100% 4%, 100% 96%, 92% 96%, 92% 100%, 8% 100%, 8% 96%, 0 96%, 0 4%, 8% 4%);
  }

  .centro__para {
    margin: 0;
    font-family: var(--ga2-f-cuerpo);
    font-size: 0.72rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--ga2-oro);
  }

  .centro__nombre {
    margin: 0;
    font-family: var(--ga2-f-titulo);
    font-size: clamp(2rem, 10vw, 2.6rem);
    line-height: 1.2;
    color: var(--ga2-oro-claro);
  }

  .centro__boton {
    margin-top: 1rem;
    min-height: 3rem;
    padding: 0.6rem 1.6rem;
    border: 1px solid var(--ga2-oro);
    background: var(--ga2-oro);
    font-family: var(--ga2-f-cuerpo);
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #000;
    cursor: pointer;
  }

  .portada[data-saliendo='true'] .centro { animation: sale 0.4s ease-in forwards; }
  .portada[data-saliendo='true'] .indicador__aguja { animation: aguja 0.8s ease-in-out forwards; }
  .portada[data-saliendo='true'] .puerta--izq { animation: abre-izq 1.1s cubic-bezier(0.7, 0, 0.3, 1) 0.8s forwards; }
  .portada[data-saliendo='true'] .puerta--der { animation: abre-der 1.1s cubic-bezier(0.7, 0, 0.3, 1) 0.8s forwards; }

  @keyframes sale { to { opacity: 0; transform: scale(0.95); } }
  @keyframes aguja { to { transform: rotate(80deg); } }
  @keyframes abre-izq { to { transform: translateX(-100%); } }
  @keyframes abre-der { to { transform: translateX(100%); } }
</style>
