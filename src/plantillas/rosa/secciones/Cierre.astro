---
import Flores from '../Flores.astro';
import Corona from '../Corona.astro';
import Foto from '../Foto.astro';

interface Props {
  nombre: string;
  despedida?: string;
  hashtag?: string;
  foto?: string;
  hueco: boolean;
}

const { nombre, despedida, hashtag, foto, hueco } = Astro.props;
---

<section class="escena cierre">
  <div class="contenedor cierre__caja">
    <div class="cierre__foto" data-anim="sube">
      <Foto src={foto} forma="ovalo" hueco={hueco} alt="" />
    </div>

    {despedida && <p class="x-script cierre__despedida" data-anim="sube">{despedida}</p>}

    {
      hashtag && (
        <p class="cierre__hashtag" data-anim="sube">
          <span class="x-caps">Comparte tus fotos</span>
          <strong>#{hashtag.replace(/^#/, '')}</strong>
        </p>
      )
    }

    <div class="cierre__firma" data-anim="escala">
      <span class="cierre__flores"><Flores variante={3} /></span>
      <Corona nombre={nombre} />
      <span class="cierre__flores"><Flores variante={3} espejo /></span>
    </div>
  </div>
</section>

<style>
  .cierre__caja {
    display: grid;
    justify-items: center;
    gap: 1.6rem;
    padding-bottom: 3rem;
    text-align: center;
  }

  .cierre__foto {
    width: min(17rem, 72vw);
  }

  .cierre__despedida {
    max-width: 20rem;
    margin: 0;
    font-size: clamp(2.2rem, 10vw, 2.8rem);
    line-height: 1.15;
    color: var(--x-rosa-osc);
  }

  .cierre__hashtag {
    display: grid;
    gap: 0.3rem;
    margin: 0;
  }

  .cierre__hashtag .x-caps {
    font-size: 0.68rem;
  }

  .cierre__hashtag strong {
    font-family: var(--x-f-serif);
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--x-tinta);
  }

  .cierre__firma {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .cierre__flores {
    display: block;
    width: 5.5rem;
  }
</style>
