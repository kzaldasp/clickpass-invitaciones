---
/** Fecha en bloque clasico + padres y padrinos. */
import EtiquetaZona from '../../compartidas/EtiquetaZona.astro';

interface Props {
  diaSemana: string;
  dia: string;
  mes: string;
  anio: string;
  hora: string;
  zona: string;
  anfitriones?: { titulo: string; nombres: string[] };
  padrinos: string[];
}

const { diaSemana, dia, mes, anio, hora, zona, anfitriones, padrinos } = Astro.props;
---

<section class="escena save">
  <div class="contenedor save__caja">
    <h2 class="x-titulo" data-anim="sube">
      <span class="x-caps">Reserva la</span>
      <span class="x-script">fecha</span>
    </h2>

    <div class="fecha" data-anim="escala">
      <p class="x-caps fecha__mes">{mes}</p>
      <div class="fecha__fila">
        <span class="x-caps fecha__lado">{diaSemana}</span>
        <span class="fecha__dia">{dia}</span>
        <span class="x-caps fecha__lado">{hora}</span>
      </div>
      <p class="x-caps fecha__anio">{anio}</p>
      <p class="fecha__zona"><EtiquetaZona zona={zona} /></p>
    </div>

    {
      (anfitriones || padrinos.length > 0) && (
        <div class="familia">
          {anfitriones && (
            <div class="familia__grupo" data-anim-grupo>
              <p class="x-caps familia__titulo">{anfitriones.titulo}</p>
              {anfitriones.nombres.map((n) => (
                <p class="familia__nombre">{n}</p>
              ))}
            </div>
          )}
          {padrinos.length > 0 && (
            <div class="familia__grupo" data-anim-grupo>
              <p class="x-caps familia__titulo">Mis padrinos</p>
              {padrinos.map((n) => (
                <p class="familia__nombre">{n}</p>
              ))}
            </div>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .save__caja {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .fecha {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
  }

  .fecha__mes,
  .fecha__anio {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.35em;
  }

  .fecha__fila {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    width: min(20rem, 88vw);
  }

  .fecha__lado {
    padding-block: 0.45rem;
    border-block: 1px solid color-mix(in srgb, var(--x-oro) 65%, transparent);
    font-size: 0.7rem;
  }

  .fecha__dia {
    font-family: var(--x-f-serif);
    font-size: 4.4rem;
    font-weight: 400;
    line-height: 1;
    color: var(--x-rosa-osc);
    font-variant-numeric: lining-nums;
  }

  .fecha__zona {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
    font-style: italic;
    color: var(--x-suave);
  }

  .familia {
    display: grid;
    gap: 2.2rem;
    margin-top: 3.2rem;
  }

  .familia__grupo {
    display: grid;
    gap: 0.2rem;
  }

  .familia__titulo {
    margin: 0 0 0.6rem;
    font-size: 0.7rem;
  }

  .familia__nombre {
    margin: 0;
    font-family: var(--x-f-serif);
    font-size: 1.2rem;
    color: var(--x-tinta);
  }

  :global(.js) .familia__grupo > * {
    opacity: 0;
    transform: translateY(1.5rem);
  }
</style>
