---
/**
 * Marco de foto con filete dorado. Sin foto: hueco "Aqui va tu foto" en
 * borrador y demo; publicada, no se dibuja nada.
 */
interface Props {
  src?: string;
  forma?: 'arco' | 'rect' | 'ovalo';
  hueco: boolean;
  alt?: string;
}

const { src, forma = 'rect', hueco, alt = '' } = Astro.props;
---

{
  src ? (
    <figure class:list={['foto', `foto--${forma}`]} data-x-foto>
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    </figure>
  ) : (
    hueco && (
      <figure class:list={['foto', `foto--${forma}`, 'foto--hueco']}>
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <path d="M8 36 L18 24 L26 32 L32 26 L40 36 Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
          <circle cx="32" cy="15" r="4" fill="none" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <figcaption>Aquí va tu foto</figcaption>
      </figure>
    )
  )
}

<style>
  .foto {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--x-rubor);
  }

  .foto img {
    width: 100%;
    height: 118%;
    object-fit: cover;
    transform: translateY(-8%);
  }

  .foto--arco {
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px 0.3rem 0.3rem;
  }

  .foto--rect {
    aspect-ratio: 4 / 5;
    border-radius: 0.2rem;
  }

  .foto--ovalo {
    aspect-ratio: 4 / 5;
    border-radius: 50%;
  }

  .foto::after {
    content: '';
    position: absolute;
    inset: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--x-oro) 70%, white);
    border-radius: inherit;
    pointer-events: none;
  }

  .foto--hueco {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    border: 1px dashed color-mix(in srgb, var(--x-rosa-osc) 45%, transparent);
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, color-mix(in srgb, var(--x-rosa) 12%, transparent) 14px 15px),
      var(--x-rubor);
    color: var(--x-rosa-osc);
  }

  .foto--hueco::after {
    display: none;
  }

  .foto--hueco svg {
    width: 2.6rem;
  }

  .foto--hueco figcaption {
    font-family: var(--x-f-script);
    font-size: 1.8rem;
  }
</style>
