---
/**
 * Mariposa de linea fina. Las alas aletean con CSS (scaleX sobre el cuerpo);
 * el vuelo por la pantalla lo pone la Plantilla con GSAP.
 */
interface Props {
  tono?: string;
}

const { tono = 'var(--x-rosa)' } = Astro.props;
---

<svg class="mariposa" viewBox="0 0 60 50" aria-hidden="true" data-mariposa>
  <g class="mariposa__ala mariposa__ala--izq">
    <path d="M30 25 C18 4 2 6 4 18 C6 26 18 26 30 25Z" fill={tono} fill-opacity="0.75" />
    <path d="M30 26 C20 30 8 38 14 45 C20 49 28 38 30 26Z" fill={tono} fill-opacity="0.55" />
  </g>
  <g class="mariposa__ala mariposa__ala--der">
    <path d="M30 25 C42 4 58 6 56 18 C54 26 42 26 30 25Z" fill={tono} fill-opacity="0.75" />
    <path d="M30 26 C40 30 52 38 46 45 C40 49 32 38 30 26Z" fill={tono} fill-opacity="0.55" />
  </g>
  <path d="M30 14 L30 38" stroke="var(--x-tinta)" stroke-width="1.6" stroke-linecap="round" />
  <path d="M30 15 C28 9 25 6 23 5 M30 15 C32 9 35 6 37 5" stroke="var(--x-tinta)" stroke-width="0.7" fill="none" />
</svg>

<style>
  .mariposa {
    display: block;
    overflow: visible;
  }

  .mariposa__ala {
    transform-box: view-box;
    transform-origin: 30px 25px;
    animation: aletear 0.32s ease-in-out infinite alternate;
  }

  .mariposa__ala--der {
    animation-delay: 0.02s;
  }

  @keyframes aletear {
    from {
      transform: scaleX(1);
    }
    to {
      transform: scaleX(0.25);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mariposa__ala {
      animation: none;
    }
  }
</style>
