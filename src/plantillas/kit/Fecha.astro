---
/**
 * Bloque de fecha clasico:      MES
 *                   DIA-SEMANA | 15 | 18:00 HRS
 *                              ANO
 */
import Titulo from './Titulo.astro';
import EtiquetaZona from '../compartidas/EtiquetaZona.astro';
import { fechaPartes } from '../../lib/fechas';
import { POR_DEFECTO } from '../../lib/config';
import type { EventoVista } from '../tipos';

interface Props {
  evento: EventoVista;
  antes?: string;
  titulo?: string;
}

const { evento, antes = 'Reserva la', titulo = 'fecha' } = Astro.props;
const p = fechaPartes(evento.fecha, evento.zonaHoraria);
const hora = new Intl.DateTimeFormat(POR_DEFECTO.locale, {
  hour: '2-digit',
  minute: '2-digit',
  hourCycle: 'h23',
  timeZone: evento.zonaHoraria,
}).format(evento.fecha);
---

<section class="escena">
  <div class="contenedor k-centro">
    <Titulo antes={antes} titulo={titulo} />
    <div class="kfecha" data-anim="escala">
      <p class="k-caps kfecha__mes">{p.mes}</p>
      <div class="kfecha__fila">
        <span class="k-caps kfecha__lado">{p.diaSemana}</span>
        <span class="kfecha__dia">{p.dia}</span>
        <span class="k-caps kfecha__lado">{hora} hrs</span>
      </div>
      <p class="k-caps kfecha__mes">{p.anio}</p>
      <p class="kfecha__zona"><EtiquetaZona zona={evento.zonaHoraria} /></p>
    </div>
  </div>
</section>

<style>
  .kfecha {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
  }

  .kfecha__mes {
    margin: 0;
    letter-spacing: 0.35em;
  }

  .kfecha__fila {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    width: min(20rem, 88vw);
  }

  .kfecha__lado {
    padding-block: 0.45rem;
    border-block: 1px solid var(--k-linea);
    font-size: 0.68rem;
  }

  .kfecha__dia {
    font-family: var(--k-f-titulo);
    font-size: 4.3rem;
    line-height: 1;
    color: var(--k-acento);
    font-variant-numeric: lining-nums;
  }

  .kfecha__zona {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
    font-style: italic;
    color: var(--k-suave);
  }
</style>
