---
/** Cinturon de campeon generico (sin logos de ninguna empresa) con el nombre grabado. */
interface Props { nombre: string; linea?: string }
const { nombre, linea = 'CAMPEÓN' } = Astro.props;
const corto = nombre.length > 10 ? nombre.slice(0, 10) : nombre;
---

<svg class="cinturon" viewBox="0 0 340 150" aria-hidden="true">
  <defs>
    <linearGradient id="lu-oro" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff3b0" />
      <stop offset=".45" stop-color="#f2b705" />
      <stop offset="1" stop-color="#9c6a00" />
    </linearGradient>
  </defs>
  <rect x="0" y="52" width="340" height="46" rx="12" fill="#1a1a1f" stroke="#333" />
  <g stroke="#6b4a00" stroke-width="1.5" fill="url(#lu-oro)">
    <rect x="20" y="46" width="52" height="58" rx="8" />
    <rect x="268" y="46" width="52" height="58" rx="8" />
    <path d="M90 30 L250 30 L272 75 L250 120 L90 120 L68 75 Z" />
    <path d="M104 42 L236 42 L252 75 L236 108 L104 108 L88 75 Z" fill="none" />
  </g>
  <circle cx="46" cy="75" r="11" fill="var(--lu-rojo)" stroke="#6b4a00" />
  <circle cx="294" cy="75" r="11" fill="var(--lu-rojo)" stroke="#6b4a00" />
  <text x="170" y="64" text-anchor="middle" style="font-family: var(--lu-f-titulo)" font-size="14" letter-spacing="3" fill="#6b4a00">{linea}</text>
  <text x="170" y="92" text-anchor="middle" style="font-family: var(--lu-f-titulo)" font-size="26" fill="#3a2600">{corto.toUpperCase()}</text>
  <rect class="cinturon__brillo" x="60" y="28" width="30" height="94" fill="#fff" opacity=".35" transform="skewX(-20)" />
</svg>

<style>
  .cinturon { display: block; width: 100%; overflow: visible; filter: drop-shadow(0 10px 20px rgb(0 0 0 / 0.5)); }
  .cinturon__brillo { animation: brillo 3.5s ease-in-out infinite; }
  @keyframes brillo { 0% { transform: skewX(-20deg) translateX(-60px); } 60%, 100% { transform: skewX(-20deg) translateX(300px); } }
</style>
