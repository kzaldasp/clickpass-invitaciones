---
/**
 * QR del pase: lleva el link personal del invitado. En la entrada se escanea
 * desde el panel (Entrada con QR) y marca su ingreso. La plantilla decide
 * donde ponerlo y de que tamano (--qr-tamano).
 */
import { qrSvg } from '../../lib/qr';

interface Props {
  link: string;
  class?: string;
}

const { link, class: clase } = Astro.props;
---

<div class:list={['qr-entrada', clase]} set:html={qrSvg(link, 'QR de tu pase para la entrada')} />

<style>
  :where(.qr-entrada) {
    width: var(--qr-tamano, 9rem);
    aspect-ratio: 1;
    padding: 0.35rem;
    border-radius: 0.6rem;
    background: #fff;
  }

  :where(.qr-entrada) :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
