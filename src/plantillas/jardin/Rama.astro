---
/**
 * Rama de eucalipto en acuarela. La geometria es calculada: las hojas nacen a
 * lo largo de una curva de Bezier, alternando lados y siguiendo la tangente.
 * El tallo se dibuja con DrawSVG y las hojas brotan en cascada (ver Plantilla).
 *
 * El borde irregular de acuarela lo da el filtro #j-acuarela, definido una
 * sola vez en Plantilla.astro.
 */
interface Props {
  /** Variante de forma: cambia la curva y el numero de hojas. */
  variante?: 1 | 2 | 3;
  /** Espejo horizontal (para la esquina derecha). */
  espejo?: boolean;
  class?: string;
}

const { variante = 1, espejo = false, class: clase } = Astro.props;

type P = [number, number];
const curvas: Record<number, [P, P, P, P]> = {
  1: [[10, 290], [60, 190], [120, 120], [230, 20]],
  2: [[20, 300], [40, 200], [150, 170], [210, 40]],
  3: [[15, 250], [90, 230], [150, 120], [260, 90]],
};
const hojasPor: Record<number, number> = { 1: 13, 2: 11, 3: 12 };

const [p0, p1, p2, p3] = curvas[variante];
const punto = (t: number): P => {
  const u = 1 - t;
  return [
    u ** 3 * p0[0] + 3 * u * u * t * p1[0] + 3 * u * t * t * p2[0] + t ** 3 * p3[0],
    u ** 3 * p0[1] + 3 * u * u * t * p1[1] + 3 * u * t * t * p2[1] + t ** 3 * p3[1],
  ];
};
const tangente = (t: number) => {
  const [a, b] = [punto(Math.max(0, t - 0.01)), punto(Math.min(1, t + 0.01))];
  return (Math.atan2(b[1] - a[1], b[0] - a[0]) * 180) / Math.PI;
};

// Pseudoaleatorio estable: la misma rama sale igual en cada render.
let semilla = variante * 97;
const azar = () => ((semilla = (semilla * 9301 + 49297) % 233280) / 233280);

const n = hojasPor[variante];
const hojas = Array.from({ length: n }, (_, i) => {
  const t = 0.12 + (i / (n - 1)) * 0.86;
  const [x, y] = punto(t);
  const lado = i % 2 === 0 ? 1 : -1;
  const angulo = tangente(t) + lado * (38 + azar() * 18);
  // Las hojas crecen hacia la punta y se achican al final, como en la planta.
  const escala = (0.75 + Math.sin(t * Math.PI) * 0.55) * (0.85 + azar() * 0.3);
  const tono = azar() > 0.55 ? 'var(--j-hoja)' : 'var(--j-salvia)';
  return { x, y, angulo, escala, tono, opacidad: 0.55 + azar() * 0.35 };
});
// Una hoja terminal en la punta.
const [xf, yf] = punto(1);
hojas.push({ x: xf, y: yf, angulo: tangente(1), escala: 1.05, tono: 'var(--j-salvia)', opacidad: 0.8 });

const tallo = `M${p0[0]},${p0[1]} C${p1[0]},${p1[1]} ${p2[0]},${p2[1]} ${p3[0]},${p3[1]}`;
const HOJA = 'M0,0 C7,-9 24,-11 34,0 C24,11 7,9 0,0Z';
---

<svg
  class:list={['rama', clase]}
  viewBox="0 0 280 310"
  aria-hidden="true"
  style={espejo ? 'transform: scaleX(-1)' : undefined}
  data-rama
>
  <g filter="url(#j-acuarela)">
    <path class="rama__tallo" d={tallo} fill="none" stroke="var(--j-salvia-osc)" stroke-width="2" stroke-linecap="round" />
    {
      hojas.map((h) => (
        <g transform={`translate(${h.x.toFixed(1)} ${h.y.toFixed(1)}) rotate(${h.angulo.toFixed(1)}) scale(${h.escala.toFixed(2)})`}>
          <g class="rama__hoja">
            <path d={HOJA} fill={h.tono} fill-opacity={h.opacidad.toFixed(2)} />
            <path d="M2,0 L30,0" stroke="var(--j-salvia-osc)" stroke-width="0.6" stroke-opacity="0.45" fill="none" />
          </g>
        </g>
      ))
    }
  </g>
</svg>

<style>
  .rama {
    display: block;
    overflow: visible;
    pointer-events: none;
  }
</style>
