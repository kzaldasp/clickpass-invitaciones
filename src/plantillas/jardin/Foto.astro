---
/**
 * Marco de foto. Si no hay foto: en vista previa o borrador muestra el hueco
 * "Aqui va su foto" (para que el cliente sepa que falta); publicado, el marco
 * desaparece y la invitacion sigue viendose completa.
 */
interface Props {
  src?: string;
  forma?: 'arco' | 'rect' | 'ovalo';
  /** Mostrar el hueco cuando no hay foto. */
  hueco: boolean;
  alt?: string;
  class?: string;
}

const { src, forma = 'rect', hueco, alt = '', class: clase } = Astro.props;
---

{
  src ? (
    <figure class:list={['foto', `foto--${forma}`, clase]} data-j-foto>
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    </figure>
  ) : (
    hueco && (
      <figure class:list={['foto', `foto--${forma}`, 'foto--hueco', clase]}>
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <path d="M8 36 L18 24 L26 32 L32 26 L40 36 Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
          <circle cx="32" cy="15" r="4" fill="none" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <figcaption>Aquí va su foto</figcaption>
      </figure>
    )
  )
}

<style>
  .foto {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--j-papel-2);
  }

  .foto img {
    width: 100%;
    height: 118%;
    object-fit: cover;
    /* Margen extra para el parallax: la foto se mueve dentro del marco. */
    transform: translateY(-8%);
  }

  .foto--arco {
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px 0.4rem 0.4rem;
  }

  .foto--rect {
    aspect-ratio: 4 / 5;
    border-radius: 0.3rem;
  }

  .foto--ovalo {
    aspect-ratio: 4 / 5;
    border-radius: 50%;
  }

  /* Filete interior, como un paspartu fino. */
  .foto::after {
    content: '';
    position: absolute;
    inset: 0.55rem;
    border: 1px solid rgb(255 255 255 / 0.65);
    border-radius: inherit;
    pointer-events: none;
  }

  .foto--hueco {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    border: 1px dashed color-mix(in srgb, var(--j-salvia-osc) 45%, transparent);
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, color-mix(in srgb, var(--j-salvia) 7%, transparent) 14px 15px),
      var(--j-papel-2);
    color: var(--j-salvia-osc);
  }

  .foto--hueco::after {
    display: none;
  }

  .foto--hueco svg {
    width: 2.6rem;
  }

  .foto--hueco figcaption {
    font-family: var(--j-f-script);
    font-size: 1.6rem;
  }
</style>
