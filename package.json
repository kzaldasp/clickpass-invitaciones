{
  "name": "clickpass",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:dev": "PATH=$HOME/.turso:$PATH turso dev -f local.db -p 8880",
    "db:seed": "tsx scripts/sembrar.ts",
    "admin:crear": "tsx scripts/crear-admin.ts",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "instantanea": "bash scripts/publicar-instantanea.sh"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@libsql/client": "^0.18.0",
    "astro": "^7.3.4",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.15.0",
    "jsqr": "^1.4.0",
    "lenis": "^1.3.26",
    "qrcode-generator": "^2.0.4",
    "wrangler": "^4.140.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
